# Dedicated personal Review Room deployment. Keep secret values private.
REVIEW_ROOM_CONVEX_URL=https://review-convex.v1su4.dev
REVIEW_ROOM_CONVEX_ADMIN_KEY=
REVIEW_ROOM_OWNER_PASSWORD=
REVIEW_ROOM_OWNER_EMAIL=gordo@v1su4.com
REVIEW_ROOM_SESSION_SECRET=

# Convex CLI deployment, used only when deploying schema/functions.
CONVEX_SELF_HOSTED_URL=https://review-convex.v1su4.dev
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Private RustFS bucket and app-scoped service account.
S3_ENDPOINT=https://s3.v1su4.dev
S3_REGION=us-east-1
S3_BUCKET=review-room-svelte
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional media worker; it fails closed without an explicit personal target.
CONVEX_SITE_URL=https://review-convex-site.v1su4.dev
MEDIA_WORKER_PORT=8787
MEDIA_WORKER_SECRET=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Archived guide publication only. Leave unset during Stage 1.
OUTLINE_KEY=
OUTLINE_API_URL=
OUTLINE_DOC_ID=
