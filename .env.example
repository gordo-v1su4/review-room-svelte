############################
# Convex — Client (browser)
#
# Review Room is Next.js → use NEXT_PUBLIC_* (required for browser).
# If importing env from pindeck, run scripts/use-homelab-env.ps1 to convert VITE_* names.
############################
NEXT_PUBLIC_CONVEX_URL=https://unfold.serving.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://unfold-site.serving.cloud

############################
# Convex — Deploy (self-hosted)
############################
CONVEX_SELF_HOSTED_URL=https://unfold.serving.cloud
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Do NOT set CONVEX_DEPLOYMENT when targeting homelab production.
# (Local `convex dev` may add CONVEX_DEPLOYMENT=anonymous:... — remove for homelab deploy.)

############################
# Convex Auth
#
# JWT_PRIVATE_KEY + JWKS belong on the CONVEX DEPLOYMENT env (not Vercel).
# See docs/deploy-vercel-and-auth.md. Local value here is for reference only.
############################
SITE_URL=http://localhost:3000
JWT_PRIVATE_KEY=

# Set on Convex deployment (same as pindeck if shared homelab backend):
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated exact emails or domains allowed to become dashboard users.
# Examples: gordo@v1su4.com,buzero.io,studiodrift.com,*@example.com
AUTH_EMAIL_ALLOWLIST=

############################
# RustFS — S3-compatible (Next.js presign routes)
############################
S3_ENDPOINT=https://s3.v1su4.dev
S3_PUBLIC_BASE_URL=https://s3.v1su4.dev
S3_REGION=us-east-1
S3_BUCKET=review-room
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

############################
# Optional — RustFS media gateway (Pindeck pattern)
############################
USE_MEDIA_GATEWAY=0
MEDIA_GATEWAY_URL=https://media.v1su4.dev
MEDIA_GATEWAY_TOKEN=
MEDIA_GATEWAY_BUCKET=unfold-review-room
MEDIA_GATEWAY_UPLOAD_PREFIX=unfold-review-room-uploads
############################
# Media worker
############################
MEDIA_WORKER_URL=http://127.0.0.1:8787
MEDIA_WORKER_SECRET=
FFMPEG_PATH=ffmpeg

############################
# Outline — client how-to docs publish
#
# Used by: bun documentation/notion-client-guide/publish-to-outline.ts
# Create an API key in Outline → Settings → API Keys (ol_api_...).
# Doc: https://outline.serving.cloud/doc/review-room-client-how-to-tyvVldHFgb
############################
OUTLINE_KEY=
