{
  "name": "review-room-svelte",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "deploy:convex": "convex deploy",
    "worker:media": "bun --env-file=.env.local run services/media-worker/index.ts",
    "docs:annotate": "bun documentation/notion-client-guide/marker-editor/server.ts"
  },
  "dependencies": {
    "@skeletonlabs/skeleton": "^4",
    "@sveltejs/kit": "^2",
    "bits-ui": "^2",
    "lucide-svelte": "^0.577.0",
    "mediabunny": "^1.59.0",
    "svelte": "^5",
    "@auth/core": "^0.37.4",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@convex-dev/auth": "^0.0.90",
    "convex": "^1.33.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6",
    "@sveltejs/vite-plugin-svelte": "^6",
    "@tailwindcss/vite": "^4",
    "@types/bun": "latest",
    "@webgpu/types": "^0.1.74",
    "svelte-check": "^4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7",
    "@markerjs/markerjs3": "^3.10.0",
    "sharp": "^0.35.3",
    "@types/node": "^22.19.0"
  }
