{
  "openapi": "3.1.0",
  "info": {
    "title": "Review Room basic agent API",
    "version": "1.0.0",
    "description": "Canonical media library. Authentication is scoped rr_v1_ bearer credentials. Upload originals and a real JPEG poster using returned signed PUT URLs within 15 minutes, without forwarding the API bearer key to storage. Original MIME must match begin request. Session lifetime is one hour. Still images use durationSec=0 and become ready without video processing; videos wait for the returned job to finish. Sync to portfolio apps is an explicit separate operation and is not implemented by this basic API."
  },
  "servers": [
    {
      "url": "https://review.v1su4.dev"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
