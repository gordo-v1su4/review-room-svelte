  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "rr_v1_*",
        "description": "BWS REVIEW_ROOM_AGENT_API_KEY. Scope and project restrictions enforced server-side."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "ProjectCreate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "FolderCreate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "parentFolderId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque Convex ID; resolve from catalog or create response."
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "FolderRename": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "UploadBegin": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque Convex ID; resolve from catalog or create response."
          },
          "folderId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque Convex ID; resolve from catalog or create response."
          },
          "name": {
            "type": "string",
            "maxLength": 240
          },
          "type": {
            "type": "string",
            "description": "video/* or image/jpeg, image/png, image/webp, image/avif"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 94371840
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "required": [
          "projectId",
          "name",
          "type",
          "size",
          "sha256"
        ],
        "additionalProperties": false
      },
      "UploadTicket": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque Convex ID; resolve from catalog or create response."
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "posterUrl": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "number"
          }
        },
        "required": [
          "sessionId",
          "url",
          "posterUrl",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "UploadComplete": {
        "type": "object",
        "properties": {
          "posterSizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5242880
          },
          "durationSec": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400,
            "description": "Positive for video; zero for still images."
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          }
        },
        "required": [
          "posterSizeBytes",
          "durationSec",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    }
  }
}
